local function n(cls, props, children)
    local i = Instance.new(cls)
    for k, v in pairs(props or {}) do i[k] = v end
    for _, c in ipairs(children or {}) do c.Parent = i end
    return i
end

local function corner(p, r)
    n("UICorner", { CornerRadius = UDim.new(0, r), Parent = p })
end

local function stroke(p, col, th, trans)
    return n("UIStroke", {
        Color = col, Thickness = th,
        Transparency = trans or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = p,
    })
end

local function makeBrandIcon(parent, assetPath, letter, size, letterSize, posX)
    posX = posX or 8
    if assetPath then
        return n("ImageLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.fromOffset(size, size),
            Position = UDim2.new(0, posX, 0.5, -size / 2),
            Image = assetPath,
            ScaleType = Enum.ScaleType.Fit,
            Parent = parent,
        })
    else
        local frame = n("Frame", {
            BackgroundColor3 = C.accent,
            Size = UDim2.fromOffset(size, size),
            Position = UDim2.new(0, posX, 0.5, -size / 2),
            BorderSizePixel = 0, Parent = parent,
        })
        corner(frame, math.floor(size * 0.28))
        stroke(frame, Color3.fromRGB(255, 255, 255), 1, 0.85)
        n("TextLabel", {
            BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
            Text = letter or "S",
            TextColor3 = Color3.new(1, 1, 1),
            Font = Enum.Font.Montserrat, TextSize = letterSize,
            Parent = frame,
        })
        return frame
    end
end

