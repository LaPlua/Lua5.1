-- 抽出来的公共高亮函数
function Window:_applyIconGroupHighlight(iconKey)
    for key, group in pairs(self._IconGroups) do
        if key == iconKey then
            group.bar.Visible = true
            TweenService:Create(group.icon, TweenInfo.new(0.15), { TextColor3 = C.iconActive }):Play()
        else
            group.bar.Visible = false
            TweenService:Create(group.icon, TweenInfo.new(0.15), { TextColor3 = C.iconIdle }):Play()
        end
    end
end

function Window:_rebuildSubList(iconKey)
    for _, btn in ipairs(self._SubButtons) do
        btn:Destroy()
    end
    self._SubButtons = {}

    local group = self._IconGroups[iconKey]
    if not group then return end

    for i, tabObj in ipairs(group.tabs) do
        local isActive = (self._CurrentTab == tabObj)
        local item = n("TextButton", {
            BackgroundColor3 = isActive and C.subItemAct or C.subItem,
            Size = UDim2.new(1, 0, 0, 32),
            Text = "", AutoButtonColor = false,
            LayoutOrder = i, Parent = self._SubScroll,
        })
        corner(item, 8)

        local indicator = n("Frame", {
            BackgroundColor3 = C.accent,
            Size = UDim2.new(0, 3, 0, 16),
            Position = UDim2.new(0, -6, 0.5, -8),
            BorderSizePixel = 0,
            Visible = isActive, Parent = item,
        })
        corner(indicator, 2)

        local label = n("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -20, 1, 0),
            Position = UDim2.new(0, 12, 0, 0),
            Text = tabObj.Name,
            TextColor3 = isActive and C.text or C.textDim,
            TextSize = 12, Font = Enum.Font.Montserrat,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = item,
        })

        item.MouseEnter:Connect(function()
            if self._CurrentTab ~= tabObj then
                TweenService:Create(item, TweenInfo.new(0.15), { BackgroundColor3 = C.subItemHover }):Play()
                TweenService:Create(label, TweenInfo.new(0.15), { TextColor3 = C.text }):Play()
            end
        end)
        item.MouseLeave:Connect(function()
            if self._CurrentTab ~= tabObj then
                TweenService:Create(item, TweenInfo.new(0.15), { BackgroundColor3 = C.subItem }):Play()
                TweenService:Create(label, TweenInfo.new(0.15), { TextColor3 = C.textDim }):Play()
            end
        end)
        item.MouseButton1Click:Connect(function()
            self:SelectTab(tabObj)
        end)

        item._indicator = indicator
        item._label = label
        item._tab = tabObj
        table.insert(self._SubButtons, item)
    end

    -- 淡入动画
    self._SubScroll.CanvasPosition = Vector2.new(0, 0)
    local conn
    local startT = tick()
    conn = RunService.RenderStepped:Connect(function()
        local dt = tick() - startT
        if dt >= 0.15 then
            conn:Disconnect()
            return
        end
        for _, item in ipairs(self._SubButtons) do
            if item.Parent then
                item.BackgroundTransparency = 1 - (dt / 0.15)
            end
        end
    end)
end

function Window:_updateSubHighlight()
    for _, item in ipairs(self._SubButtons) do
        local isActive = (self._CurrentTab == item._tab)
        item.BackgroundColor3 = isActive and C.subItemAct or C.subItem
        item._indicator.Visible = isActive
        item._label.TextColor3 = isActive and C.text or C.textDim
    end
end

function Window:Tab(config)
    config = config or {}
    local iconKey = config.Icon or "_default"
    config.Icon = iconKey

    -- 创建 Tab 对象（含独立 Page）
    local tabObj = Tab.new(self, config, self._PageContainer)
    table.insert(self._Tabs, tabObj)

    local group = self._IconGroups[iconKey]

    if not group then
        local sidebarBtn = n("TextButton", {
            Size = UDim2.fromOffset(44, 44),
            BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
            Parent = self._Sidebar,
        })
        corner(sidebarBtn, 11)

        local activeBar = n("Frame", {
            BackgroundColor3 = C.accent,
            Size = UDim2.new(0, 3, 0, 22),
            Position = UDim2.new(0, -14, 0.5, -11),
            BorderSizePixel = 0, Visible = false, Parent = sidebarBtn,
        })
        corner(activeBar, 2)

        local iconText = n("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1),
            Text = SKING:Icon(iconKey),
            TextColor3 = C.iconIdle,
            TextSize = 20, Font = Enum.Font.GothamBold,
            Parent = sidebarBtn,
        })

        group = {
            iconKey = iconKey,
            btn = sidebarBtn,
            bar = activeBar,
            icon = iconText,
            tabs = {},
        }
        self._IconGroups[iconKey] = group
        table.insert(self._IconOrder, iconKey)

        sidebarBtn.MouseEnter:Connect(function()
            if self._ActiveIconKey ~= iconKey then
                TweenService:Create(iconText, TweenInfo.new(0.15), { TextColor3 = C.text }):Play()
            end
        end)
        sidebarBtn.MouseLeave:Connect(function()
            if self._ActiveIconKey ~= iconKey then
                TweenService:Create(iconText, TweenInfo.new(0.15), { TextColor3 = C.iconIdle }):Play()
            end
        end)
        sidebarBtn.MouseButton1Click:Connect(function()
            self:_selectIconGroup(iconKey)
        end)
    end

    table.insert(group.tabs, tabObj)
    tabObj._IconGroup = group

    if #self._Tabs == 1 then
        self._ActiveIconKey = iconKey
        self:_applyIconGroupHighlight(iconKey)
        self:_rebuildSubList(iconKey)
        self:SelectTab(tabObj)
    elseif self._ActiveIconKey == iconKey then
        self:_rebuildSubList(iconKey)
    end

    return tabObj
end

function Window:_selectIconGroup(iconKey)
    if self._ActiveIconKey == iconKey then
        local group = self._IconGroups[iconKey]
        if group and #group.tabs > 0 then
            self:SelectTab(group.tabs[1])
        end
        return
    end

    self._ActiveIconKey = iconKey
    self:_applyIconGroupHighlight(iconKey)

    local group = self._IconGroups[iconKey]
    if group and #group.tabs > 0 then
        self:SelectTab(group.tabs[1])
    else
        self:_rebuildSubList(iconKey)
    end
end

function Window:SelectTab(tabObj)
    local previousTab = self._CurrentTab
    self._CurrentTab = tabObj

    -- 切换 Page 显示
    for _, t in ipairs(self._Tabs) do
        if t == tabObj then
            t.Page.Visible = true
        else
            t.Page.Visible = false
        end
    end

    -- 目标 Tab 不在当前激活分组 → 切分组
    local targetIcon = tabObj.Icon
    if targetIcon and self._ActiveIconKey ~= targetIcon then
        self._ActiveIconKey = targetIcon
        self:_applyIconGroupHighlight(targetIcon)
        self:_rebuildSubList(targetIcon)
    else
        -- 同分组内切 Tab，如果副栏里没有对应按钮，就重建（比如新 Tab 加进来时）
        local found = false
        for _, item in ipairs(self._SubButtons) do
            if item._tab == tabObj then
                found = true
                break
            end
        end
        if found then
            self:_updateSubHighlight()
        else
            self:_rebuildSubList(self._ActiveIconKey)
        end
    end
end

function Window:Open()
    if self._Animating or self._IsOpen then return end
    self._Animating = true
    self._IsOpen = true

    local MAIN_W, MAIN_H = self._MainW, self._MainH
    self._MainHolder.Visible = true
    self._MainHolder.Position = UDim2.new(0.5, 0, 0.5, 0)
    self._MainHolder.Size = UDim2.fromOffset(MAIN_W, MAIN_H)
    self._Main.AnchorPoint = Vector2.new(0.5, 0.5)
    self._Main.Position = UDim2.new(0.5, 0, 0.5, 0)
    self._Main.Size = UDim2.fromOffset(80, 40)
    self._Main.BackgroundTransparency = 0

    local tw = TweenService:Create(self._Main, TweenInfo.new(0.45, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Size = UDim2.fromOffset(MAIN_W, MAIN_H),
    })
    tw:Play()

    self._FloatHint.Text = "点击收起"
    TweenService:Create(self._FloatHint, TweenInfo.new(0.25), { TextColor3 = C.success }):Play()
    TweenService:Create(self._IndicatorDot, TweenInfo.new(0.25), { BackgroundColor3 = C.success }):Play()
    TweenService:Create(self._IndicatorPulse, TweenInfo.new(0.25), { BackgroundColor3 = C.success }):Play()

    tw.Completed:Connect(function() self._Animating = false end)
end

function Window:Close()
    if self._Animating or not self._IsOpen then return end
    self._Animating = true
    self._IsOpen = false

    if self._ActiveMenu then
        local m = self._ActiveMenu
        self._ActiveMenu = nil
        m.close()
    end

    local tw = TweenService:Create(self._Main, TweenInfo.new(0.38, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
        Size = UDim2.fromOffset(80, 40),
    })
    tw:Play()

    self._FloatHint.Text = "点击展开"
    TweenService:Create(self._FloatHint, TweenInfo.new(0.25), { TextColor3 = C.textDim }):Play()
    TweenService:Create(self._IndicatorDot, TweenInfo.new(0.25), { BackgroundColor3 = C.accent }):Play()
    TweenService:Create(self._IndicatorPulse, TweenInfo.new(0.25), { BackgroundColor3 = C.accent }):Play()

    tw.Completed:Connect(function()
        self._MainHolder.Visible = false
        self._Animating = false
    end)
end

function Window:Toggle()
    if self._IsOpen then
        self:Close()
    else
        self:Open()
    end
end

function Window:SetScale(scale)
    if self._MainScale then
        self._MainScale.Scale = math.clamp(scale, 0.3, 2)
    end
end

return SKING
