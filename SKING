        local vp = cam.ViewportSize
        if vp.X <= 0 or vp.Y <= 0 then return end

        local targetW = vp.X * 0.82
        local targetH = vp.Y * 0.82

        local sW = targetW / MAIN_W
        local sH = targetH / MAIN_H
        local scale = math.min(sW, sH)
