local ICON_DATA_URL = "https://raw.githubusercontent.com/Footagesus/Icons/main/Main-v2.lua"

local iconPackData = nil
local iconsReady = false

task.spawn(function()
    local ok, result = pcall(function()
        local src = game:HttpGet(ICON_DATA_URL)
        local fn = loadstring(src)
        if not fn then return nil end
        return fn()
    end)
    if ok and result then
        iconPackData = result
    end
    iconsReady = true
end)

local function parseIconString(str)
    if type(str) ~= "string" then return nil, nil end
    local colonPos = str:find(":")
    if colonPos then
        return str:sub(1, colonPos - 1), str:sub(colonPos + 1)
    end
    return nil, str
end

function SKING:Icon(name)
    if not iconPackData or not name then
        return { Image = "", ImageRectSize = Vector2.new(0, 0), ImageRectOffset = Vector2.new(0, 0) }
    end
    local packName, iconName = parseIconString(name)
    packName = packName or self.IconsPack or "lucide"
    local pack = iconPackData.Icons and iconPackData.Icons[packName]
    if not pack or not pack.Icons or not pack.Icons[iconName] then
        return { Image = "", ImageRectSize = Vector2.new(0, 0), ImageRectOffset = Vector2.new(0, 0) }
    end
    local data = pack.Icons[iconName]
    return {
        Image = data.Image or "",
        ImageRectSize = data.ImageRectSize or Vector2.new(0, 0),
        ImageRectOffset = data.ImageRectPosition or Vector2.new(0, 0),
    }
end

