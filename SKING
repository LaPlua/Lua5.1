local function isURL(str)
    return type(str) == "string" and str:match("^https?://") ~= nil
end

local function sanitizeFilename(url)
    local name = url:match("([^/]+)$") or "image"
    name = name:gsub("([^%w%-_%.])", "_")
    if not name:match("%.") then name = name .. ".png" end
    if #name > 64 then name = name:sub(1, 64) end
    return name
end

local function loadImageFromURL(url, folder)
    if not isURL(url) then return nil end
    if not (writefile and getcustomasset and isfile and isfolder and makefolder) then return nil end
    local req = request or http_request or (syn and syn.request) or (http and http.request)
    if not req then return nil end

    pcall(function()
        if not isfolder(folder) then makefolder(folder) end
        if not isfolder(folder .. "/assets") then makefolder(folder .. "/assets") end
    end)

    local path = folder .. "/assets/" .. sanitizeFilename(url)

    if not isfile(path) then
        local ok, res = pcall(function()
            return req({
                Url = url,
                Method = "GET",
                Headers = { ["User-Agent"] = "Roblox/Exploit" }
            })
        end)
        if not ok or not res or not res.Body then return nil end
        local writeOk = pcall(writefile, path, res.Body)
        if not writeOk then return nil end
    end

    local ok, asset = pcall(getcustomasset, path)
    if ok and asset then return asset end
    return nil
end

