local Tab = {}
Tab.__index = Tab

function Tab.new(parentWindow, config)
    local self = setmetatable({}, Tab)
    self.Window = parentWindow
    self.Config = config
    self.Name = config.Title or "Tab"
    self.Icon = config.Icon
    self.LeftCol = parentWindow._LeftCol
    self.RightCol = parentWindow._RightCol
    self._currentCol = "right"
    self._leftOrder = 0
    self._rightOrder = 0
    return self
end

function Tab:_nextOrder()
    if self._currentCol == "left" then
        self._leftOrder = self._leftOrder + 1
        return self._leftOrder
    else
        self._rightOrder = self._rightOrder + 1
        return self._rightOrder
    end
end

function Tab:_currentParent()
    return (self._currentCol == "left") and self.LeftCol or self.RightCol
end

function Tab:Section(title)
    self._currentCol = (self._currentCol == "left") and "right" or "left"
    local parent = self:_currentParent()
    local order = self:_nextOrder()
    return n("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 22),
        Text = title, TextColor3 = C.textDim,
        TextSize = 11, Font = Enum.Font.Montserrat,
        TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = order, Parent = parent,
    })
end

function Tab:Toggle(config)
    local parent = self:_currentParent()
    local order = self:_nextOrder()
    local state = config.Default == true
    local trackW, trackH = 44, 24

    local card = n("Frame", {
        BackgroundColor3 = C.card,
        Size = UDim2.new(1, 0, 0, 62),
        BorderSizePixel = 0, LayoutOrder = order, Parent = parent,
    })
    corner(card, 11)
    stroke(card, Color3.fromRGB(34, 34, 42), 1, 0.5)

    n("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -94, 0, 18),
        Position = UDim2.new(0, 16, 0, 13),
        Text = config.Title or "", TextColor3 = C.text,
        TextSize = 12.5, Font = Enum.Font.Montserrat,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = card,
    })
    n("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -94, 0, 22),
        Position = UDim2.new(0, 16, 0, 33),
        Text = config.Desc or "", TextColor3 = C.textDesc,
        TextSize = 10.5, Font = Enum.Font.Montserrat,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true, Parent = card,
    })

    local track = n("TextButton", {
        BackgroundColor3 = state and C.accent or C.toggleOff,
        Size = UDim2.fromOffset(trackW, trackH),
        Position = UDim2.new(1, -58, 0.5, -trackH / 2),
        Text = "", AutoButtonColor = false, Parent = card,
    })
    corner(track, trackH / 2)
    stroke(track, Color3.fromRGB(0, 0, 0), 1, 0.7)

    n("Frame", {
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BackgroundTransparency = 0.92,
        Size = UDim2.new(1, -4, 0, trackH / 2 - 2),
        Position = UDim2.new(0, 2, 0, 2),
        BorderSizePixel = 0, Parent = track,
    }).Name = "Highlight"
    corner(track.Highlight, trackH / 4 - 1)

    local knobShadow = n("Frame", {
        BackgroundColor3 = Color3.fromRGB(0, 0, 0),
        BackgroundTransparency = 0.7,
        Size = UDim2.fromOffset(trackH - 4, trackH - 4),
        Position = UDim2.new(0, state and (trackW - trackH + 1) or 3, 0.5, -(trackH - 4) / 2 + 1),
        BorderSizePixel = 0, ZIndex = 2, Parent = track,
    })
    corner(knobShadow, (trackH - 4) / 2)

    local knob = n("Frame", {
        BackgroundColor3 = C.toggleKnob,
        Size = UDim2.fromOffset(trackH - 4, trackH - 4),
        Position = UDim2.new(0, state and (trackW - trackH + 1) or 3, 0.5, -(trackH - 4) / 2),
        BorderSizePixel = 0, ZIndex = 3, Parent = track,
    })
    corner(knob, (trackH - 4) / 2)
    stroke(knob, Color3.fromRGB(0, 0, 0), 1, 0.85)

    local knobDot = n("Frame", {
        BackgroundColor3 = state and C.accent or Color3.fromRGB(180, 180, 190),
        Size = UDim2.fromOffset(7, 7),
        Position = UDim2.new(0.5, -3.5, 0.5, -3.5),
        BorderSizePixel = 0, ZIndex = 4, Parent = knob,
    })
    corner(knobDot, 3.5)

    local function apply(v)
        local targetX = v and (trackW - trackH + 1) or 3
        TweenService:Create(track, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            BackgroundColor3 = v and C.accent or C.toggleOff,
        }):Play()
        TweenService:Create(knob, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Position = UDim2.new(0, targetX, 0.5, -(trackH - 4) / 2),
        }):Play()
        TweenService:Create(knobShadow, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Position = UDim2.new(0, targetX + 1, 0.5, -(trackH - 4) / 2 + 1),
        }):Play()
        TweenService:Create(knobDot, TweenInfo.new(0.22), {
            BackgroundColor3 = v and C.accent or Color3.fromRGB(180, 180, 190),
        }):Play()
    end

    track.MouseButton1Click:Connect(function()
        state = not state
        apply(state)
        if config.Callback then config.Callback(state) end
    end)

    local obj = {}
    function obj:Get() return state end
    function obj:Set(v)
        if state ~= v then
            state = v
            apply(v)
            if config.Callback then config.Callback(v) end
        end
    end
    return obj
end

function Tab:Slider(config)
    local parent = self:_currentParent()
    local order = self:_nextOrder()
    local value = config.Default or 0
    local minV, maxV = config.Min or 0, config.Max or 100

    local card = n("Frame", {
        BackgroundColor3 = C.card,
        Size = UDim2.new(1, 0, 0, 80),
        BorderSizePixel = 0, LayoutOrder = order, Parent = parent,
    })
    corner(card, 11)
    stroke(card, Color3.fromRGB(34, 34, 42), 1, 0.5)

    n("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -140, 0, 18),
        Position = UDim2.new(0, 16, 0, 13),
        Text = config.Title or "", TextColor3 = C.text,
        TextSize = 12.5, Font = Enum.Font.Montserrat,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = card,
    })
    n("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -140, 0, 18),
        Position = UDim2.new(0, 16, 0, 32),
        Text = config.Desc or "", TextColor3 = C.textDesc,
        TextSize = 10.5, Font = Enum.Font.Montserrat,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top, Parent = card,
    })

    local valueLabel = n("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(46, 18),
        Position = UDim2.new(1, -226, 0.5, -9),
        Text = string.format("%.1f", value),
        TextColor3 = C.text, TextSize = 12,
        Font = Enum.Font.Montserrat,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = card,
    })

    local sliderW = 170
    local trackH = 12

    local slider = n("Frame", {
        BackgroundColor3 = C.track,
        Size = UDim2.fromOffset(sliderW, trackH),
        Position = UDim2.new(1, -186, 0.5, -trackH / 2),
        BorderSizePixel = 0, Parent = card,
    })
    corner(slider, trackH / 2)

    n("Frame", {
        BackgroundColor3 = Color3.fromRGB(0, 0, 0),
        BackgroundTransparency = 0.7,
        Size = UDim2.new(1, -4, 0, trackH / 2 - 2),
        Position = UDim2.new(0, 2, 0, 2),
        BorderSizePixel = 0, Parent = slider,
    }).Name = "TopHighlight"
    corner(slider.TopHighlight, trackH / 4 - 1)

    local function pct()
        return (value - minV) / (maxV - minV)
    end

    local fill = n("Frame", {
        BackgroundColor3 = C.accent,
        Size = UDim2.new(pct(), 0, 1, 0),
        BorderSizePixel = 0, Parent = slider,
    })
    corner(fill, trackH / 2)
    n("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, C.accentDark),
            ColorSequenceKeypoint.new(1, C.accentLight),
        }),
        Rotation = 0, Parent = fill,
    })

    local knobW, knobH = 10, 22
    local knobShadow = n("Frame", {
        BackgroundColor3 = Color3.fromRGB(0, 0, 0),
        BackgroundTransparency = 0.55,
        Size = UDim2.fromOffset(knobW, knobH),
        Position = UDim2.new(pct(), -knobW / 2, 0.5, -knobH / 2 + 2),
        BorderSizePixel = 0, ZIndex = 2, Parent = slider,
    })
    corner(knobShadow, 3)

    local knob = n("Frame", {
        BackgroundColor3 = C.toggleKnob,
        Size = UDim2.fromOffset(knobW, knobH),
        Position = UDim2.new(pct(), -knobW / 2, 0.5, -knobH / 2),
        BorderSizePixel = 0, ZIndex = 3, Parent = slider,
    })
    corner(knob, 3)
    stroke(knob, Color3.fromRGB(180, 180, 190), 1, 0.5)

    local dragging = false

    local function update(x)
        local rel = math.clamp((x - slider.AbsolutePosition.X) / slider.AbsoluteSize.X, 0, 1)
        value = minV + (maxV - minV) * rel
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, -knobW / 2, 0.5, -knobH / 2)
        knobShadow.Position = UDim2.new(rel, -knobW / 2, 0.5, -knobH / 2 + 2)
        valueLabel.Text = string.format("%.1f", value)
        if config.Callback then config.Callback(value) end
    end

    slider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input.Position.X)
        end
    end)
    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    local obj = {}
    function obj:Get() return value end
    function obj:Set(v)
        value = math.clamp(v, minV, maxV)
        local rel = pct()
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, -knobW / 2, 0.5, -knobH / 2)
        knobShadow.Position = UDim2.new(rel, -knobW / 2, 0.5, -knobH / 2 + 2)
        valueLabel.Text = string.format("%.1f", value)
        if config.Callback then config.Callback(value) end
    end
    return obj
end

function Tab:Dropdown(config)
    local parent = self:_currentParent()
    local order = self:_nextOrder()
    local options = config.Options or {}
    local selected = config.Default or options[1] or ""
    local window = self.Window
    local toggleMenuFn = nil
    local menuOpen = false

    local card = n("Frame", {
        BackgroundColor3 = C.card,
        Size = UDim2.new(1, 0, 0, 62),
        BorderSizePixel = 0, LayoutOrder = order, Parent = parent,
    })
    corner(card, 11)
    stroke(card, Color3.fromRGB(34, 34, 42), 1, 0.5)

    n("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -140, 0, 18),
        Position = UDim2.new(0, 16, 0, 13),
        Text = config.Title or "", TextColor3 = C.text,
        TextSize = 12.5, Font = Enum.Font.Montserrat,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = card,
    })
    n("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -140, 0, 22),
        Position = UDim2.new(0, 16, 0, 33),
        Text = config.Desc or "", TextColor3 = C.textDesc,
        TextSize = 10.5, Font = Enum.Font.Montserrat,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true, Parent = card,
    })

    local btn = n("TextButton", {
        BackgroundColor3 = C.track,
        Size = UDim2.fromOffset(110, 30),
        Position = UDim2.new(1, -126, 0.5, -15),
        Text = "", AutoButtonColor = false,
        ZIndex = 3, Parent = card,
    })
    corner(btn, 8)
    local btnStroke = stroke(btn, C.strokeOuter, 1, 0.4)
    n("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(48, 48, 56)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(36, 36, 44)),
        }),
        Rotation = 90, Parent = btn,
    })

    local label = n("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -28, 1, 0),
        Position = UDim2.new(0, 11, 0, 0),
        Text = selected, TextColor3 = C.text,
        TextSize = 11.5, Font = Enum.Font.Montserrat,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = btn,
    })

    local arrow = n("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(14, 14),
        Position = UDim2.new(1, -22, 0.5, -7),
        Text = "▾", TextColor3 = C.textDim,
        TextSize = 12, Font = Enum.Font.Montserrat,
        Parent = btn,
    })

    local menu = n("Frame", {
        BackgroundColor3 = C.cardHover,
        Size = UDim2.new(0, 110, 0, 0),
        BorderSizePixel = 0, Visible = false,
        ClipsDescendants = true,
        ZIndex = 101, Parent = window._Overlay,
    })
    corner(menu, 8)
    stroke(menu, C.strokeOuter, 1, 0.1)
    n("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(34, 34, 40)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(26, 26, 32)),
        }),
        Rotation = 90, Parent = menu,
    })

    local inner = n("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, #options * 26 + 8),
        Parent = menu,
    })
    n("UIListLayout", {
        Padding = UDim.new(0, 2),
        SortOrder = Enum.SortOrder.LayoutOrder, Parent = inner,
    })
    n("UIPadding", {
        PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4),
        PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4),
        Parent = inner,
    })

    local items = {}
    for i, opt in ipairs(options) do
        local item = n("TextButton", {
            BackgroundColor3 = Color3.fromRGB(0, 0, 0),
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 24),
            Text = "", AutoButtonColor = false,
            LayoutOrder = i, Parent = inner,
        })
        corner(item, 5)

        local indicator = n("Frame", {
            BackgroundColor3 = C.accent,
            Size = UDim2.new(0, 2, 0, 0),
            Position = UDim2.new(0, 4, 0.5, 0),
            BorderSizePixel = 0, Parent = item,
        })
        corner(indicator, 1)

        local text = n("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -16, 1, 0),
            Position = UDim2.new(0, 11, 0, 0),
            Text = opt, TextColor3 = C.text,
            TextSize = 11.5, Font = Enum.Font.Montserrat,
            TextXAlignment = Enum.TextXAlignment.Left, Parent = item,
        })

        local function setVisual(isSel)
            if isSel then
                indicator.Size = UDim2.new(0, 2, 0, 12)
                indicator.Position = UDim2.new(0, 4, 0.5, -6)
                text.TextColor3 = C.accent
                text.Position = UDim2.new(0, 13, 0, 0)
            else
                indicator.Size = UDim2.new(0, 2, 0, 0)
                indicator.Position = UDim2.new(0, 4, 0.5, 0)
                text.TextColor3 = C.text
                text.Position = UDim2.new(0, 11, 0, 0)
            end
        end
        setVisual(opt == selected)

        item.MouseEnter:Connect(function()
            TweenService:Create(item, TweenInfo.new(0.15), { BackgroundTransparency = 0.85 }):Play()
            TweenService:Create(text, TweenInfo.new(0.15), { Position = UDim2.new(0, 15, 0, 0) }):Play()
        end)
        item.MouseLeave:Connect(function()
            TweenService:Create(item, TweenInfo.new(0.15), { BackgroundTransparency = 1 }):Play()
            TweenService:Create(text, TweenInfo.new(0.15), {
                Position = UDim2.new(0, (opt == selected) and 13 or 11, 0, 0),
            }):Play()
        end)
        item.MouseButton1Click:Connect(function()
            selected = opt
            label.Text = opt
            for _, entry in ipairs(items) do entry.setVisual(entry.opt == selected) end
            if toggleMenuFn then toggleMenuFn(false) end
            if config.Callback then config.Callback(opt) end
        end)

        table.insert(items, { opt = opt, setVisual = setVisual })
    end

    function toggleMenuFn(open)
        if open == nil then open = not menuOpen end
        if open == menuOpen then return end
        menuOpen = open

        if open then
            if window._ActiveMenu and window._ActiveMenu.close then
                local prev = window._ActiveMenu
                window._ActiveMenu = nil
                prev.close()
            end
            window._ActiveMenu = { close = function() toggleMenuFn(false) end }

            local btnAbs = btn.AbsolutePosition
            local mainAbs = window._Main.AbsolutePosition
            menu.Position = UDim2.new(0, btnAbs.X - mainAbs.X, 0, btnAbs.Y - mainAbs.Y + 34)
            menu.Visible = true
            menu.Size = UDim2.new(0, 110, 0, 0)
            menu.BackgroundTransparency = 0.1
            window._BgClick.Visible = true
            window._Overlay.Visible = true

            TweenService:Create(menu, TweenInfo.new(0.24, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 110, 0, #options * 26 + 8),
                BackgroundTransparency = 0,
            }):Play()
            TweenService:Create(arrow, TweenInfo.new(0.24, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Rotation = 180,
            }):Play()
            TweenService:Create(btnStroke, TweenInfo.new(0.2), { Color = C.accent }):Play()
            TweenService:Create(label, TweenInfo.new(0.2), { TextColor3 = C.accent }):Play()
        else
            window._ActiveMenu = nil
            window._BgClick.Visible = false

            TweenService:Create(menu, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
                Size = UDim2.new(0, 110, 0, 0),
                BackgroundTransparency = 0.15,
            }):Play()
            TweenService:Create(arrow, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
                Rotation = 0,
            }):Play()
            TweenService:Create(btnStroke, TweenInfo.new(0.2), { Color = C.strokeOuter }):Play()
            TweenService:Create(label, TweenInfo.new(0.2), { TextColor3 = C.text }):Play()
            task.delay(0.2, function()
                if not menuOpen then
                    menu.Visible = false
                    if not window._ActiveMenu then window._Overlay.Visible = false end
                end
            end)
        end
    end

    btn.MouseButton1Click:Connect(function() toggleMenuFn() end)

    local obj = { _options = options }
    function obj:Get() return selected end
    function obj:SetValues(newOptions)
        options = newOptions
        obj._options = newOptions
    end
    return obj
end

