function Window:Tab(config)
    config = config or {}
    local index = #self._Tabs + 1

    local tabBtn = n("TextButton", {
        Size = UDim2.fromOffset(84, 28),
        BackgroundColor3 = (index == 1) and C.tabActive or C.tabIdle,
        BackgroundTransparency = (index == 1) and 0 or 0.5,
        Text = "", AutoButtonColor = false,
        LayoutOrder = index, Parent = self._TabBarWrap,
    })
    corner(tabBtn, 14)

    local tabLabel = n("TextLabel", {
        BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
        Text = config.Title or "Tab",
        TextColor3 = (index == 1) and C.text or C.textDim,
        TextSize = 12, Font = Enum.Font.Montserrat,
        Parent = tabBtn,
    })

    local tabObj = Tab.new(self, config)
    tabObj._Btn = tabBtn
    tabObj._Label = tabLabel

    if config.Icon then
        local sidebarBtn = n("TextButton", {
            Size = UDim2.fromOffset(44, 44),
            Position = UDim2.new(0.5, -22, 0, 22 + (#self._Tabs) * 56),
            BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
            Parent = self._Sidebar,
        })
        corner(sidebarBtn, 11)

        local isFirst = (#self._Tabs == 0)
        local activeBar = n("Frame", {
            BackgroundColor3 = C.accent,
            Size = UDim2.new(0, 3, 0, 22),
            Position = UDim2.new(0, -20, 0.5, -11),
            BorderSizePixel = 0, Visible = isFirst, Parent = sidebarBtn,
        })
        corner(activeBar, 2)

        local iconText = n("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1),
            Text = SKING:Icon(config.Icon),
            TextColor3 = isFirst and C.iconActive or C.iconIdle,
            TextSize = 20, Font = Enum.Font.GothamBold,
            Parent = sidebarBtn,
        })

        sidebarBtn.MouseEnter:Connect(function()
            if self._CurrentTab ~= tabObj then
                TweenService:Create(iconText, TweenInfo.new(0.15), { TextColor3 = C.text }):Play()
            end
        end)
        sidebarBtn.MouseLeave:Connect(function()
            if self._CurrentTab ~= tabObj then
                TweenService:Create(iconText, TweenInfo.new(0.15), { TextColor3 = C.iconIdle }):Play()
            end
        end)
        sidebarBtn.MouseButton1Click:Connect(function()
            self:SelectTab(tabObj)
        end)

        table.insert(self._SidebarButtons, {
            btn = sidebarBtn, bar = activeBar, icon = iconText, tab = tabObj,
        })

        tabObj._SidebarBtn = sidebarBtn
        tabObj._SidebarBar = activeBar
        tabObj._SidebarIcon = iconText
    end

    tabBtn.MouseButton1Click:Connect(function()
        self:SelectTab(tabObj)
    end)

    table.insert(self._Tabs, tabObj)
    table.insert(self._TabButtons, { btn = tabBtn, label = tabLabel, tab = tabObj })

    if #self._Tabs == 1 then
        self:SelectTab(tabObj)
    end

    return tabObj
end

function Window:SelectTab(tabObj)
    self._CurrentTab = tabObj
    for _, entry in ipairs(self._TabButtons) do
        if entry.tab == tabObj then
            entry.btn.BackgroundColor3 = C.tabActive
            TweenService:Create(entry.btn, TweenInfo.new(0.15), { BackgroundTransparency = 0 }):Play()
            entry.label.TextColor3 = C.text
        else
            TweenService:Create(entry.btn, TweenInfo.new(0.15), { BackgroundTransparency = 0.5 }):Play()
            entry.label.TextColor3 = C.textDim
        end
    end
    for _, sb in ipairs(self._SidebarButtons) do
        if sb.tab == tabObj then
            sb.bar.Visible = true
            TweenService:Create(sb.icon, TweenInfo.new(0.15), { TextColor3 = C.iconActive }):Play()
        else
            sb.bar.Visible = false
            TweenService:Create(sb.icon, TweenInfo.new(0.15), { TextColor3 = C.iconIdle }):Play()
        end
    end
end

function Window:Open()
    if self._Animating or self._IsOpen then return end
    self._Animating = true
    self._IsOpen = true

    local MAIN_W, MAIN_H = self._MainW, self._MainH
    self._MainHolder.Visible = true
    self._MainHolder.Position = UDim2.new(0.5, 0, 0.5, 0)
    self._MainHolder.Size = UDim2.fromOffset(MAIN_W, MAIN_H)
    self._Main.AnchorPoint = Vector2.new(0.5, 0.5)
    self._Main.Position = UDim2.new(0.5, 0, 0.5, 0)
    self._Main.Size = UDim2.fromOffset(80, 40)
    self._Main.BackgroundTransparency = 0

    local tw = TweenService:Create(self._Main, TweenInfo.new(0.45, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Size = UDim2.fromOffset(MAIN_W, MAIN_H),
    })
    tw:Play()

    self._FloatHint.Text = "点击收起"
    TweenService:Create(self._FloatHint, TweenInfo.new(0.25), { TextColor3 = C.success }):Play()
    TweenService:Create(self._IndicatorDot, TweenInfo.new(0.25), { BackgroundColor3 = C.success }):Play()
    TweenService:Create(self._IndicatorPulse, TweenInfo.new(0.25), { BackgroundColor3 = C.success }):Play()

    tw.Completed:Connect(function() self._Animating = false end)
end

function Window:Close()
    if self._Animating or not self._IsOpen then return end
    self._Animating = true
    self._IsOpen = false

    if self._ActiveMenu then
        local m = self._ActiveMenu
        self._ActiveMenu = nil
        m.close()
    end

    local tw = TweenService:Create(self._Main, TweenInfo.new(0.38, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
        Size = UDim2.fromOffset(80, 40),
    })
    tw:Play()

    self._FloatHint.Text = "点击展开"
    TweenService:Create(self._FloatHint, TweenInfo.new(0.25), { TextColor3 = C.textDim }):Play()
    TweenService:Create(self._IndicatorDot, TweenInfo.new(0.25), { BackgroundColor3 = C.accent }):Play()
    TweenService:Create(self._IndicatorPulse, TweenInfo.new(0.25), { BackgroundColor3 = C.accent }):Play()

    tw.Completed:Connect(function()
        self._MainHolder.Visible = false
        self._Animating = false
    end)
end

function Window:Toggle()
    if self._IsOpen then
        self:Close()
    else
        self:Open()
    end
end

function Window:SetScale(scale)
    if self._MainScale then
        self._MainScale.Scale = math.clamp(scale, 0.3, 2)
    end
end

return SKING
