        Text = config.Title or "Tab",
        TextColor3 = C.textDim,
        TextSize = 12, Font = Enum.Font.Montserrat,
        Parent = btn,
    })

    tab._Btn = btn
    tab._Label = label

    -- 内容容器（滚动 + 两列）
    local page = n("ScrollingFrame", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = C.track,
        ScrollBarImageTransparency = 0.3,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        Visible = false,
        Parent = contentWrap,
    })

    local columnsWrap = n("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Parent = page,
    })
    n("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        Padding = UDim.new(0, 16),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = columnsWrap,
    })

    local leftCol = n("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(0.5, -8, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = 1, Parent = columnsWrap,
    })
    n("UIListLayout", {
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder, Parent = leftCol,
    })

    local rightCol = n("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(0.5, -8, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = 2, Parent = columnsWrap,
    })
    n("UIListLayout", {
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder, Parent = rightCol,
    })

    tab._Page = page
    tab.ContentLeft = leftCol
    tab.ContentRight = rightCol

    btn.MouseButton1Click:Connect(function()
        self:SelectTab(tab)
    end)

    if #self.Tabs == 1 then
        self:SelectTab(tab)
    end

    return tab
end

function Category:SelectTab(tab)
    self._activeTab = tab
    for _, t in ipairs(self.Tabs) do
        if t == tab then
            t._Btn.BackgroundColor3 = C.tabActive
            TweenService:Create(t._Btn, TweenInfo.new(0.15), { BackgroundTransparency = 0 }):Play()
            t._Label.TextColor3 = C.text
            t._Page.Visible = true
        else
            TweenService:Create(t._Btn, TweenInfo.new(0.15), { BackgroundTransparency = 0.5 }):Play()
            t._Label.TextColor3 = C.textDim
            t._Page.Visible = false
        end
    end
end

function Category:Show()
    self.Container.Visible = true
end
function Category:Hide()
    self.Container.Visible = false
end

