function Window:Category(config)
    config = config or {}
    local category = Category.new(self, config)
    table.insert(self._Categories, category)

    local sidebarBtn = newInstance("TextButton", {
        Size = UDim2.fromOffset(44, 44),
        Position = UDim2.new(0.5, -22, 0, 22 + (#self._Categories - 1) * 56),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        Parent = self._Sidebar,
    })
    addCorner(sidebarBtn, 11)

    local activeBar = newInstance("Frame", {
        BackgroundColor3 = Colors.accent,
        Size = UDim2.new(0, 3, 0, 22),
        Position = UDim2.new(0, -20, 0.5, -11),
        BorderSizePixel = 0,
        Visible = false,
        Parent = sidebarBtn,
    })
    addCorner(activeBar, 2)

    local iconText = newInstance("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Text = SKING:Icon(config.Icon),
        TextColor3 = Colors.iconIdle,
        TextSize = 20,
        Font = Enum.Font.GothamBold,
        Parent = sidebarBtn,
    })

    sidebarBtn.MouseEnter:Connect(function()
        if self._ActiveCategory ~= category then
            TweenService:Create(iconText, TweenInfo.new(0.15), { TextColor3 = Colors.text }):Play()
        end
    end)
    sidebarBtn.MouseLeave:Connect(function()
        if self._ActiveCategory ~= category then
            TweenService:Create(iconText, TweenInfo.new(0.15), { TextColor3 = Colors.iconIdle }):Play()
        end
    end)
    sidebarBtn.MouseButton1Click:Connect(function()
        self:SelectCategory(category)
    end)

    category._SidebarBtn = sidebarBtn
    category._SidebarBar = activeBar
    category._SidebarIcon = iconText

    if #self._Categories == 1 then
        self:SelectCategory(category)
    end

    return category
end

function Window:SelectCategory(category)
    self._ActiveCategory = category
    for _, cat in ipairs(self._Categories) do
        if cat == category then
            cat:Show()
            cat._SidebarBar.Visible = true
            TweenService:Create(cat._SidebarIcon, TweenInfo.new(0.15), { TextColor3 = Colors.iconActive }):Play()
        else
            cat:Hide()
            cat._SidebarBar.Visible = false
            TweenService:Create(cat._SidebarIcon, TweenInfo.new(0.15), { TextColor3 = Colors.iconIdle }):Play()
        end
    end
end

function Window:Open()
    if self._Animating or self._IsOpen then return end
    self._Animating = true
    self._IsOpen = true

    local mainW, mainH = self._MainW, self._MainH
    self._MainHolder.Visible = true
    self._MainHolder.Position = UDim2.new(0.5, -mainW / 2, 0.5, -mainH / 2)
    self._MainHolder.Size = UDim2.fromOffset(mainW, mainH)
    self._Main.AnchorPoint = Vector2.new(0.5, 0.5)
    self._Main.Position = UDim2.new(0.5, 0, 0.5, 0)
    self._Main.Size = UDim2.fromOffset(80, 40)
    self._Main.BackgroundTransparency = 0

    local tween = TweenService:Create(self._Main, TweenInfo.new(0.45, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Size = UDim2.fromOffset(mainW, mainH),
    })
    tween:Play()

    self._FloatHint.Text = "点击收起"
    TweenService:Create(self._FloatHint, TweenInfo.new(0.25), { TextColor3 = Colors.success }):Play()
    TweenService:Create(self._IndicatorDot, TweenInfo.new(0.25), { BackgroundColor3 = Colors.success }):Play()
    TweenService:Create(self._IndicatorPulse, TweenInfo.new(0.25), { BackgroundColor3 = Colors.success }):Play()

    tween.Completed:Connect(function()
        self._Animating = false
    end)
end

function Window:Close()
    if self._Animating or not self._IsOpen then return end
    self._Animating = true
    self._IsOpen = false

    if self._ActiveMenu then
        local menu = self._ActiveMenu
        self._ActiveMenu = nil
        menu.close()
    end

    local tween = TweenService:Create(self._Main, TweenInfo.new(0.38, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
        Size = UDim2.fromOffset(80, 40),
    })
    tween:Play()

    self._FloatHint.Text = "点击展开"
    TweenService:Create(self._FloatHint, TweenInfo.new(0.25), { TextColor3 = Colors.textDim }):Play()
    TweenService:Create(self._IndicatorDot, TweenInfo.new(0.25), { BackgroundColor3 = Colors.accent }):Play()
    TweenService:Create(self._IndicatorPulse, TweenInfo.new(0.25), { BackgroundColor3 = Colors.accent }):Play()

    tween.Completed:Connect(function()
        self._MainHolder.Visible = false
        self._Animating = false
    end)
end

function Window:Toggle()
    if self._IsOpen then
        self:Close()
    else
        self:Open()
    end
end

return SKING
