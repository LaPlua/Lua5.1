local Tab = {}
Tab.__index = Tab

function Tab.new(category, config)
    local self = setmetatable({}, Tab)
    self.Category = category
    self.Config = config
    self.Title = config.Title or "Tab"
    self._currentColumn = "right"
    self._leftOrder = 0
    self._rightOrder = 0
    return self
end

function Tab:_nextOrder()
    if self._currentColumn == "left" then
        self._leftOrder = self._leftOrder + 1
        return self._leftOrder
    else
        self._rightOrder = self._rightOrder + 1
        return self._rightOrder
    end
end

function Tab:_currentParent()
    if self._currentColumn == "left" then
        return self.ContentLeft
    else
        return self.ContentRight
    end
end

function Tab:Section(title)
    self._currentColumn = (self._currentColumn == "left") and "right" or "left"
    return newInstance("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 22),
        Text = title,
        TextColor3 = Colors.textDim,
        TextSize = 11,
        Font = Enum.Font.Montserrat,
        TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = self:_nextOrder(),
        Parent = self:_currentParent(),
    })
end

function Tab:Toggle(config)
    local parent = self:_currentParent()
    local order = self:_nextOrder()
    local state = config.Default == true
    local trackW, trackH = 44, 24

    local card = newInstance("Frame", {
        BackgroundColor3 = Colors.card,
        Size = UDim2.new(1, 0, 0, 62),
        BorderSizePixel = 0,
        LayoutOrder = order,
        Parent = parent,
    })
    addCorner(card, 11)
    addStroke(card, Colors.cardBorder, 1, 0.4)

    newInstance("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -94, 0, 18),
        Position = UDim2.new(0, 16, 0, 13),
        Text = config.Title or "",
        TextColor3 = Colors.text,
        TextSize = 12.5,
        Font = Enum.Font.Montserrat,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = card,
    })
    newInstance("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -94, 0, 22),
        Position = UDim2.new(0, 16, 0, 33),
        Text = config.Desc or "",
        TextColor3 = Colors.textDesc,
        TextSize = 10.5,
        Font = Enum.Font.Montserrat,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true,
        Parent = card,
    })

    local track = newInstance("TextButton", {
        BackgroundColor3 = state and Colors.accent or Colors.toggleOff,
        Size = UDim2.fromOffset(trackW, trackH),
        Position = UDim2.new(1, -58, 0.5, -trackH / 2),
        Text = "",
        AutoButtonColor = false,
        Parent = card,
    })
    addCorner(track, trackH / 2)
    addStroke(track, Color3.new(0, 0, 0), 1, 0.7)

    local highlight = newInstance("Frame", {
        BackgroundColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = 0.92,
        Size = UDim2.new(1, -4, 0, trackH / 2 - 2),
        Position = UDim2.new(0, 2, 0, 2),
        BorderSizePixel = 0,
        Parent = track,
    })
    addCorner(highlight, trackH / 4 - 1)

    local knobShadow = newInstance("Frame", {
        BackgroundColor3 = Color3.new(0, 0, 0),
        BackgroundTransparency = 0.7,
        Size = UDim2.fromOffset(trackH - 4, trackH - 4),
        Position = UDim2.new(0, state and (trackW - trackH + 1) or 3, 0.5, -(trackH - 4) / 2 + 1),
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = track,
    })
    addCorner(knobShadow, (trackH - 4) / 2)

    local knob = newInstance("Frame", {
        BackgroundColor3 = Colors.toggleKnob,
        Size = UDim2.fromOffset(trackH - 4, trackH - 4),
        Position = UDim2.new(0, state and (trackW - trackH + 1) or 3, 0.5, -(trackH - 4) / 2),
        BorderSizePixel = 0,
        ZIndex = 3,
        Parent = track,
    })
    addCorner(knob, (trackH - 4) / 2)
    addStroke(knob, Color3.new(0, 0, 0), 1, 0.85)

    local knobDot = newInstance("Frame", {
        BackgroundColor3 = state and Colors.accent or Color3.fromRGB(180, 180, 190),
        Size = UDim2.fromOffset(7, 7),
        Position = UDim2.new(0.5, -3.5, 0.5, -3.5),
        BorderSizePixel = 0,
        ZIndex = 4,
        Parent = knob,
    })
    addCorner(knobDot, 3.5)

    local function apply(value)
        local targetX = value and (trackW - trackH + 1) or 3
        TweenService:Create(track, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            BackgroundColor3 = value and Colors.accent or Colors.toggleOff,
        }):Play()
        TweenService:Create(knob, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Position = UDim2.new(0, targetX, 0.5, -(trackH - 4) / 2),
        }):Play()
        TweenService:Create(knobShadow, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Position = UDim2.new(0, targetX + 1, 0.5, -(trackH - 4) / 2 + 1),
        }):Play()
        TweenService:Create(knobDot, TweenInfo.new(0.22), {
            BackgroundColor3 = value and Colors.accent or Color3.fromRGB(180, 180, 190),
        }):Play()
    end

    track.MouseButton1Click:Connect(function()
        state = not state
        apply(state)
        if config.Callback then config.Callback(state) end
    end)

    local obj = {}
    function obj:Get() return state end
    function obj:Set(value)
        if state ~= value then
            state = value
            apply(value)
            if config.Callback then config.Callback(value) end
        end
    end
    return obj
end

function Tab:Slider(config)
    local parent = self:_currentParent()
    local order = self:_nextOrder()
    local value = config.Default or 0
    local minValue = config.Min or 0
    local maxValue = config.Max or 100

    local card = newInstance("Frame", {
        BackgroundColor3 = Colors.card,
        Size = UDim2.new(1, 0, 0, 80),
        BorderSizePixel = 0,
        LayoutOrder = order,
        Parent = parent,
    })
    addCorner(card, 11)
    addStroke(card, Colors.cardBorder, 1, 0.4)

    newInstance("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -140, 0, 18),
        Position = UDim2.new(0, 16, 0, 13),
        Text = config.Title or "",
        TextColor3 = Colors.text,
        TextSize = 12.5,
        Font = Enum.Font.Montserrat,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = card,
    })
    newInstance("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -140, 0, 18),
        Position = UDim2.new(0, 16, 0, 32),
        Text = config.Desc or "",
        TextColor3 = Colors.textDesc,
        TextSize = 10.5,
        Font = Enum.Font.Montserrat,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        Parent = card,
    })

    local valueLabel = newInstance("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(46, 18),
        Position = UDim2.new(1, -226, 0.5, -9),
        Text = string.format("%.1f", value),
        TextColor3 = Colors.text,
        TextSize = 12,
        Font = Enum.Font.Montserrat,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = card,
    })

    local sliderW, trackH = 170, 12

    local slider = newInstance("Frame", {
        BackgroundColor3 = Colors.track,
        Size = UDim2.fromOffset(sliderW, trackH),
        Position = UDim2.new(1, -186, 0.5, -trackH / 2),
        BorderSizePixel = 0,
        Parent = card,
    })
    addCorner(slider, trackH / 2)

    local function percent()
        return (value - minValue) / (maxValue - minValue)
    end

    local fill = newInstance("Frame", {
        BackgroundColor3 = Colors.accent,
        Size = UDim2.new(percent(), 0, 1, 0),
        BorderSizePixel = 0,
        Parent = slider,
    })
    addCorner(fill, trackH / 2)
    newInstance("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Colors.accentDark),
            ColorSequenceKeypoint.new(1, Colors.accentLight),
        }),
        Rotation = 0,
        Parent = fill,
    })

    local knobW, knobH = 10, 22

    local knobShadow = newInstance("Frame", {
        BackgroundColor3 = Color3.new(0, 0, 0),
        BackgroundTransparency = 0.55,
        Size = UDim2.fromOffset(knobW, knobH),
        Position = UDim2.new(percent(), -knobW / 2, 0.5, -knobH / 2 + 2),
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = slider,
    })
    addCorner(knobShadow, 3)

    local knob = newInstance("Frame", {
        BackgroundColor3 = Colors.toggleKnob,
        Size = UDim2.fromOffset(knobW, knobH),
        Position = UDim2.new(percent(), -knobW / 2, 0.5, -knobH / 2),
        BorderSizePixel = 0,
        ZIndex = 3,
        Parent = slider,
    })
    addCorner(knob, 3)
    addStroke(knob, Color3.fromRGB(180, 180, 190), 1, 0.5)

    local dragging = false

    local function update(x)
        local relative = math.clamp((x - slider.AbsolutePosition.X) / slider.AbsoluteSize.X, 0, 1)
        value = minValue + (maxValue - minValue) * relative
        fill.Size = UDim2.new(relative, 0, 1, 0)
        knob.Position = UDim2.new(relative, -knobW / 2, 0.5, -knobH / 2)
        knobShadow.Position = UDim2.new(relative, -knobW / 2, 0.5, -knobH / 2 + 2)
        valueLabel.Text = string.format("%.1f", value)
        if config.Callback then config.Callback(value) end
    end

    slider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input.Position.X)
        end
    end)
    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    local obj = {}
    function obj:Get() return value end
    return obj
end

