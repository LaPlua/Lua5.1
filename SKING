local function newInstance(class, props, children)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do inst[k] = v end
    for _, child in ipairs(children or {}) do child.Parent = inst end
    return inst
end

local function addCorner(parent, radius)
    newInstance("UICorner", { CornerRadius = UDim.new(0, radius), Parent = parent })
end

local function addStroke(parent, color, thickness, transparency)
    return newInstance("UIStroke", {
        Color = color,
        Thickness = thickness,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = parent,
    })
end

local function makeBrandIcon(parent, assetPath, letter, size, letterSize, posX)
    posX = posX or 8
    if assetPath then
        return newInstance("ImageLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.fromOffset(size, size),
            Position = UDim2.new(0, posX, 0.5, -size / 2),
            Image = assetPath,
            ScaleType = Enum.ScaleType.Fit,
            Parent = parent,
        })
    else
        local frame = newInstance("Frame", {
            BackgroundColor3 = Colors.accent,
            Size = UDim2.fromOffset(size, size),
            Position = UDim2.new(0, posX, 0.5, -size / 2),
            BorderSizePixel = 0,
            Parent = parent,
        })
        addCorner(frame, math.floor(size * 0.28))
        addStroke(frame, Color3.new(1, 1, 1), 1, 0.85)
        newInstance("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1),
            Text = letter or "S",
            TextColor3 = Color3.new(1, 1, 1),
            Font = Enum.Font.Montserrat,
            TextSize = letterSize,
            Parent = frame,
        })
        return frame
    end
end

